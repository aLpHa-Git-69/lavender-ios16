 {
@@ -1121,6 +1308,8 @@ wlan_qrtr_rx(const uint8_t *p, uint32_t len)
 			wlan_qrtr_send(QRTR_TYPE_RESUME_TX, dst_port, src_node,
 			    src_port, &r, sizeof(r));
 		}
