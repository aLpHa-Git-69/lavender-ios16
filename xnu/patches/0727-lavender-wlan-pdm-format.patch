+	list[0] = (uint8_t)cnt;
 	wlan_qm_result(&m, TRUE);
 	{
-		uint8_t t16[3] = { 1, (uint8_t)(cnt & 0xff),
+		uint8_t t16[2] = { (uint8_t)(cnt & 0xff),
 		    (uint8_t)(cnt >> 8) };
-		uint8_t t17[3] = { 1, 1, 0 };
+		uint8_t t17[2] = { 1, 0 };
 
 		wlan_qm_tlv(&m, 0x10, t16, sizeof(t16));
 		wlan_qm_tlv(&m, 0x11, t17, sizeof(t17));
