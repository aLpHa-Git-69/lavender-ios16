diff --git a/bsd/dev/lavender_wlan.c b/bsd/dev/lavender_wlan.c
index 5196681..1331f88 100644
--- a/bsd/dev/lavender_wlan.c
+++ b/bsd/dev/lavender_wlan.c
@@ -1694,7 +1694,7 @@ wlan_pdm_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg,
 	struct qmsg m;
 	char name[80];
 	uint8_t list[256];
-	uint32_t n = 2, cnt = 0;
+	uint32_t n = 1, cnt = 0;
 
 	wlan_qm_init(&m, txn, msg);
 	if (msg != 0x21) {
@@ -1730,21 +1730,17 @@ wlan_pdm_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg,
 		}
 	}
 	/*
-	 * TLV 18 is QMI_OPT_FLAG (domain_list_valid) + QMI_DATA_LEN (count as
-	 * one byte) + the entries, per servreg_loc_get_domain_list_resp_ei.
-	 * 0717 sent only [count][entries] (the topaz layout).
+	 * servreg_loc_get_domain_list_resp_ei as bergamota 1115 sends it:
